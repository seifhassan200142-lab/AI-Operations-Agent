# Application
AI_OPS_APP_ENV=local
AI_OPS_DATABASE_URL=sqlite:///./data/operations.db
AI_OPS_KNOWLEDGE_BASE_DIR=./knowledge_base
AI_OPS_MEMORY_WINDOW=8
AI_OPS_MAX_AGENT_STEPS=6

# Choose one provider: openai, groq, or ollama.
# Leave empty to make /api/chat return a clear setup error.
AI_OPS_LLM_PROVIDER=

# OpenAI-compatible API
AI_OPS_OPENAI_API_KEY=
AI_OPS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPS_OPENAI_MODEL=gpt-4o-mini

# Groq OpenAI-compatible API
AI_OPS_GROQ_API_KEY=
AI_OPS_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_OPS_GROQ_MODEL=llama-3.1-8b-instant

# Ollama local model
AI_OPS_OLLAMA_BASE_URL=http://localhost:11434
AI_OPS_OLLAMA_MODEL=llama3.1:8b

# Streamlit UI
AI_OPS_API_BASE_URL=http://localhost:8000
